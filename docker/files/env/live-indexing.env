# Default:8190                                              - Default HTTP port, each module defines itself
SERVER_PORT=8190
# Default:tcp://localhost:61616                             - ActiveMQ broker url
SPRING_ACTIVEMQ_BROKERURL=nio://activemq:61616
# Default:admin                                             - ActiveMQ Broker user
SPRING_ACTIVEMQ_USER=admin
# Default:admin                                             - ActiveMQ Broker password
SPRING_ACTIVEMQ_PASSWORD=admin
# Default:false                                             - Cache JMS sessions
SPRING_JMS_CACHE_ENABLED=false
# Default:http://localhost:9200                             - Comma-separated list of Elasticsearch endpoints
SPRING_ELASTICSEARCH_REST_URIS=http://elasticsearch:9200
# Default:alfresco                                          - Name of the index to be used in Elasticsearch server
ELASTICSEARCH_INDEXNAME=alfresco
# Default:activemq:queue:acs-repo-transform-request?jmsMessageType=Text - Alfresco Repository channel
ACS_REPO_TRANSFORM_REQUEST_ENDPOINT=activemq:queue:acs-repo-transform-request?jmsMessageType=Text
# Default:http://127.1.0.1:8099/alfresco/api/-default-/private/sfs/versions/1/file/ - Alfresco Shared FileStore endpoint
ALFRESCO_SHAREDFILESTORE_BASEURL=http://shared-file-store:8099/alfresco/api/-default-/private/sfs/versions/1/file/
# Default:4000                                              - Alfresco Shared FileStore maximum read timeout in milliseconds
ALFRESCO_SHAREDFILESTORE_TIMEOUT=4000
# Default:-1                                                - Alfresco Shared FileStore maximum buffer size (-1 for unlimited buffer)
ALFRESCO_SHAREDFILESTORE_MAXBUFFERSIZE=-1
# Default:activemq:topic:alfresco.repo.event2               - Topic name for Alfresco Repository events
ALFRESCO_EVENT_TOPIC=activemq:topic:alfresco.repo.event2
# Default:activemq:queue:org.alfresco.search.metadata.event - Alfresco Metadata channel
ALFRESCO_METADATA_EVENT_CHANNEL=activemq:queue:org.alfresco.search.metadata.event
# Default:activemq:queue:org.alfresco.search.content.event  - Alfresco Content channel
ALFRESCO_CONTENT_EVENT_CHANNEL=activemq:queue:org.alfresco.search.content.event
# Default:org.alfresco.search.metadata.event                - Alfresco Metadata queue name
ALFRESCO_METADATA_EVENT_QUEUE=org.alfresco.search.metadata.event
# Default: org.alfresco.search.contentrefresh.event         - The channel where transform requests are re-inserted by the content event aggregator as consequence of a failure
ALFRESCO_CONTENT_REFRESH_EVENT_QUEUE=org.alfresco.search.contentrefresh.event
# Default:org.alfresco.search.metadata.retry.event          - Alfresco Error event queue name
ALFRESCO_METADATA_RETRY_EVENT_QUEUE=org.alfresco.search.metadata.retry.event
# Default:10                                                - Maximum number of events per batch
METADATA_EVENTS_BATCH_SIZE=10
# Default:1000                                              - Maximum timeout in milliseconds for batch creation
METADATA_EVENTS_BATCH_TIMEOUT=1000
# Default:3                                                 - Maximum number of retries in case of transient failure processing
ALFRESCO_RETRANSMISSION_MAX_ATTEMPTS=3
# Default:1000                                              - Delay time for error event in milliseconds
ALFRESCO_EVENT_RETRY_DELAY=1000
# Default:0 0 * * * *                                       - Time until you refresh the cache. We can disable the scheduler by replacing the value of the cron expression with a dash “-“. In case you want to refresh the cache contents before the next scheduled refresh we should restart the application
ALFRESCO_ACCEPTEDCONTENTMEDIATYPESCACHE_REFRESHTIME="0 0 * * * *"
# Default:true                                              - Property to set if you want to enable or disable the cache for contacting the Transform Core AIO
ALFRESCO_ACCEPTEDCONTENTMEDIATYPESCACHE_ENABLED=true
# Default:http://localhost:8090/transform/config            - URL to get the list of Content Media Types supported
ALFRESCO_ACCEPTEDCONTENTMEDIATYPESCACHE_BASEURL=http://transform-core-aio:8090/transform/config
# Default:1000                                              - Delay in milliseconds to retry a Path indexing operation
ALFRESCO_PATH_RETRY_DELAY=1000
# Default:3                                                 - Maximum number of attempts to retry a Path indexing operation
ALFRESCO_PATH_RETRY_MAXATTEMPTS=3
# Default:true                                              - Index Path property
ALFRESCO_PATHINDEXINGCOMPONENT_ENABLED=true
# Default:true                                              - Index content property
ALFRESCO_CONTENTINDEXINGCOMPONENT_ENABLED=true
index.skipUnresolvableNodes=true
SPRING_ELASTICSEARCH_REST_USERNAME=elastic
SPRING_ELASTICSEARCH_REST_PASSWORD=elastic

# Default:classpath:mediation-filter.yml                    - The configuration file which contains fields and node types blacklists
#ALFRESCO_MEDIATION_FILTERFILE=classpath:mediation-filter.yml
#                                                           - Maximum number of redelivery attempts allowed. 0 is used to disable redelivery, and -1 will attempt redelivery forever until it succeeds
#ALFRESCO_CONTENT_EVENT_RETRY_MAXALLOWED
#                                                           - Exponential backoff multiplier that can be used to multiply each consequent redelivery delay
#ALFRESCO_CONTENT_EVENT_RETRY_BACKOFF
#                                                           - Initial delay in milliseconds between redelivery attempts. Subsequent delays will be affected by the backoff multiplier
#ALFRESCO_CONTENT_EVENT_RETRY_DELAY
#                                                           - An upper bound in milliseconds for the computed redelivery delay. This is used when you specify backoff multiplied delays and is used to avoid the delay growing too large
#ALFRESCO_CONTENT_EVENT_RETRY_MAXDELAY