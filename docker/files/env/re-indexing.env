RL_ACS=http://audit-share-acs:8080

# Default:8190                                        - Default HTTP port, each module defines itself
SERVER_PORT=8190
# Default:reindexByIds                                - The data fetching strategy to use: reindexByIds, or reindexByDate
ALFRESCO_REINDEX_JOBNAME=reindexByIds
# Default:100                                         - The batch size of documents inserted into Elasticesearch by the re-indexing app
ALFRESCO_REINDEX_BATCHSIZE=100
# Default:100                                         - The page size of nodes fetched from the Alfresco database
ALFRESCO_REINDEX_PAGESIZE=100
# Default:10                                          - Number of parallel processors
ALFRESCO_REINDEX_CONCURRENTPROCESSOR=10
# Default:0                                           - Start ID for fetching nodes (reindexByIds)
ALFRESCO_REINDEX_FROMID=0
# Default:20000000000                                 - End ID for fetching nodes (reindexByIds) is configured
ALFRESCO_REINDEX_TOID=20000000000
# Default:jdbc:postgresql://localhost:5432/alfresco   - JDBC url of the Alfresco database
SPRING_DATASOURCE_URL=jdbc:postgresql://audit-share-postgres:5432/alfresco
# Default:alfresco                                    - Username for the Alfresco database
SPRING_DATASOURCE_USERNAME=alfresco
# Default:alfresco                                    - Password for the Alfresco database
SPRING_DATASOURCE_PASSWORD=alfresco
# Default:http://elasticsearch:9200                   - Rest(s) url of Elasticsearch
SPRING_ELASTICSEARCH_REST_URIS=http://elasticsearch:9200
# Default:tcp://localhost:61616?jms.useAsyncSend=true - ActiveMQ Broker url, use async sending to improve performance
SPRING_ACTIVEMQ_BROKERURL=nio://activemq:61616?jms.useAsyncSend=true
# Default:admin                                       - ActiveMQ Broker user
SPRING_ACTIVEMQ_USER=admin
# Default:admin                                       - ActiveMQ Broker password
SPRING_ACTIVEMQ_PASSWORD=admin
# Default:false                                       - Enable steps to be executed in parallel threads. Retrying settings are only applied when this property is set to true
ALFRESCO_REINDEX_MULTITHREADEDSTEPENABLED=false
# Default:true                                        - Retry the execution of a step in case of fail
ALFRESCO_REINDEX_RETRYINGENABLED=true
# Default:3                                           - Number of times to retry the step before throwing an error
ALFRESCO_REINDEX_RETRYINGMAXCOUNT=3
# Default:1000                                        - Waiting time before retrying the step in milliseconds
ALFRESCO_REINDEX_RETRYINGINITIALDELAY=1000
# Default:2                                           - Every try should wait N times the initial delay, where N is the number specified in this property
ALFRESCO_REINDEX_RETRYINGDELAYINTERVALMULTIPLIER=2
# Default:30000                                       - Maximum delay to be waited before executing a retry on a step
ALFRESCO_REINDEX_RETRYINGMAXDELAY=30000
# Uses the image's built-in classpath:reindex.prefixes-file.json mapping.
# Default:3                                           - Number of partitions, usually equals the number of available workers
ALFRESCO_REINDEX_PARTITIONING_GRIDSIZE=3
# Default:http://localhost:8090/transform/config      - URL to get the list of Content Media Types supported
ALFRESCO_ACCEPTEDCONTENTMEDIATYPESCACHE_BASEURL=http://transform-core-aio:8090/transform/config
# Default:true                                        - Cache the list of Content Media Types supported in memory
ALFRESCO_ACCEPTEDCONTENTMEDIATYPESCACHE_ENABLED=true
# Default:true                                        - Re-index document metadata
ALFRESCO_REINDEX_METADATAINDEXINGENABLED=true
# Default:true                                        - Re-index document content
ALFRESCO_REINDEX_CONTENTINDEXINGENABLED=true
# Default:false                                       - Re-index document Path property
ALFRESCO_REINDEX_PATHINDEXINGENABLED=true
SPRING_ELASTICSEARCH_REST_USERNAME=elastic
SPRING_ELASTICSEARCH_REST_PASSWORD=elastic
# Default:190001010000                                - Start time for fetching nodes (reindexByDate), pattern: yyyyMMddHHmm
#ALFRESCO_REINDEX_FROMTIME=190001010000
# Default:203012312359                                - End time for fetching nodes (reindexByDate), pattern: yyyyMMddHHmm
#ALFRESCO_REINDEX_TOTIME=203012312359
#                                                     - Username for Elasticsearch when using Basic Authentication
#SPRING_ELASTICSEARCH_REST_USERNAME
#                                                     - Password for Elasticsearch when using Basic Authentication
#SPRING_ELASTICSEARCH_REST_PASSWORD
# Default:''                                          - Remote node type, can be master or worker. If not specified, the app runs as a single node instance
#ALFRESCO_REINDEX_PARTITIONING_TYPE
# Default:org.alfresco.search.reindex.requests        - Request queue for remote partitioning
#ALFRESCO_REINDEX_PARTITIONING_REQUESTSQUEUE
# Default:org.alfresco.search.reindex.replies         - Request queue for remote partitioning
#ALFRESCO_REINDEX_PARTITIONING_REPLIESQUEUE
